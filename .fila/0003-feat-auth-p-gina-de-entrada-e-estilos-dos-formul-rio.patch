diff --git a/web/css/formularios.css b/web/css/formularios.css
new file mode 100644
index 0000000..6546bba
--- /dev/null
+++ b/web/css/formularios.css
@@ -0,0 +1,118 @@
+.formulario {
+    display: flex;
+    flex-direction: column;
+    gap: 14px;
+}
+
+.campo {
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+    font-size: 13px;
+    color: var(--cor-texto-suave);
+}
+
+.campo small {
+    font-size: 12px;
+}
+
+.campo input,
+.campo select,
+.campo textarea {
+    background-color: var(--cor-fundo);
+    border: 1px solid var(--cor-borda);
+    color: var(--cor-texto);
+    border-radius: 12px;
+    padding: 11px 12px;
+    font: inherit;
+    font-size: 15px;
+    transition: border-color 0.2s;
+}
+
+.campo textarea {
+    resize: vertical;
+    min-height: 70px;
+}
+
+.campo input:focus,
+.campo select:focus,
+.campo textarea:focus {
+    outline: none;
+    border-color: var(--cor-destaque);
+}
+
+.linha-campos {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
+    gap: 12px;
+}
+
+.botao {
+    border: 1px solid var(--cor-borda);
+    background-color: var(--cor-cartao-alto);
+    color: var(--cor-texto);
+    border-radius: var(--raio-pilula);
+    padding: 11px 18px;
+    font: inherit;
+    font-size: 14px;
+    font-weight: 500;
+    cursor: pointer;
+    transition: opacity 0.2s, background-color 0.2s;
+}
+
+.botao:hover {
+    opacity: 0.85;
+}
+
+.botao:disabled {
+    opacity: 0.5;
+    cursor: wait;
+}
+
+.botao-principal {
+    background-color: var(--cor-destaque);
+    border-color: var(--cor-destaque);
+    color: #0b0b0d;
+}
+
+.botao-perigo {
+    color: var(--cor-despesa);
+}
+
+.botao-link {
+    background: none;
+    border: none;
+    color: var(--cor-texto-suave);
+    font: inherit;
+    font-size: 13px;
+    cursor: pointer;
+    padding: 4px;
+}
+
+.botao-link:hover {
+    color: var(--cor-texto);
+}
+
+.escondido {
+    display: none !important;
+}
+
+.texto-suave {
+    color: var(--cor-texto-suave);
+    font-size: 14px;
+}
+
+.mensagem {
+    min-height: 20px;
+    font-size: 13px;
+    color: var(--cor-texto-suave);
+    margin-top: 12px;
+}
+
+.mensagem.erro {
+    color: var(--cor-despesa);
+}
+
+.mensagem.ok {
+    color: var(--cor-destaque);
+}
diff --git a/web/css/login.css b/web/css/login.css
new file mode 100644
index 0000000..1a96b73
--- /dev/null
+++ b/web/css/login.css
@@ -0,0 +1,52 @@
+.entrada {
+    min-height: 100vh;
+    display: grid;
+    place-items: center;
+    padding: 24px 16px;
+}
+
+.entrada-cartao {
+    width: 100%;
+    max-width: 380px;
+    background-color: var(--cor-cartao);
+    border: 1px solid var(--cor-borda);
+    border-radius: var(--raio-cartao);
+    padding: 32px 28px;
+}
+
+.entrada-cartao .logo {
+    padding: 0;
+    margin-bottom: 4px;
+}
+
+.entrada-slogan {
+    color: var(--cor-texto-suave);
+    font-size: 14px;
+    margin-bottom: 24px;
+}
+
+.separadores {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    background-color: var(--cor-fundo);
+    border: 1px solid var(--cor-borda);
+    border-radius: var(--raio-pilula);
+    padding: 4px;
+    margin-bottom: 20px;
+}
+
+.separador {
+    background: none;
+    border: none;
+    color: var(--cor-texto-suave);
+    border-radius: var(--raio-pilula);
+    padding: 8px;
+    font: inherit;
+    font-size: 14px;
+    cursor: pointer;
+}
+
+.separador.ativo {
+    background-color: var(--cor-cartao-alto);
+    color: var(--cor-texto);
+}
diff --git a/web/login.html b/web/login.html
index e69de29..7a6782b 100644
--- a/web/login.html
+++ b/web/login.html
@@ -0,0 +1,82 @@
+<!doctype html>
+<html lang="pt">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>HUROH · Entrar</title>
+
+    <link rel="preconnect" href="https://fonts.googleapis.com" />
+    <link
+      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
+      rel="stylesheet"
+    />
+
+    <link rel="stylesheet" href="css/base.css" />
+    <link rel="stylesheet" href="css/formularios.css" />
+    <link rel="stylesheet" href="css/login.css" />
+  </head>
+  <body>
+    <main class="entrada">
+      <div class="entrada-cartao">
+        <div class="logo">HUROH</div>
+        <p class="entrada-slogan">Your life. In sync.</p>
+
+        <div class="separadores" id="separadores">
+          <button type="button" class="separador ativo" data-modo="entrar">Entrar</button>
+          <button type="button" class="separador" data-modo="registar">Criar conta</button>
+        </div>
+
+        <form class="formulario" id="form-entrar" data-modo="entrar">
+          <label class="campo">
+            <span>Email</span>
+            <input type="email" name="email" autocomplete="email" required />
+          </label>
+          <label class="campo">
+            <span>Palavra-passe</span>
+            <input type="password" name="senha" autocomplete="current-password" required />
+          </label>
+          <button type="submit" class="botao botao-principal">Entrar</button>
+          <button type="button" class="botao-link" id="link-recuperar">Esqueci-me da palavra-passe</button>
+        </form>
+
+        <form class="formulario escondido" id="form-registar" data-modo="registar">
+          <label class="campo">
+            <span>Nome</span>
+            <input type="text" name="nome" maxlength="60" autocomplete="given-name" required />
+          </label>
+          <label class="campo">
+            <span>Email</span>
+            <input type="email" name="email" autocomplete="email" required />
+          </label>
+          <label class="campo">
+            <span>Palavra-passe</span>
+            <input type="password" name="senha" minlength="8" autocomplete="new-password" required />
+            <small>Mínimo de 8 caracteres.</small>
+          </label>
+          <button type="submit" class="botao botao-principal">Criar conta</button>
+        </form>
+
+        <form class="formulario escondido" id="form-recuperar" data-modo="recuperar">
+          <p class="texto-suave">Enviamos um email com um link para definires uma nova palavra-passe.</p>
+          <label class="campo">
+            <span>Email</span>
+            <input type="email" name="email" autocomplete="email" required />
+          </label>
+          <button type="submit" class="botao botao-principal">Enviar link</button>
+          <button type="button" class="botao-link" id="link-voltar">Voltar</button>
+        </form>
+
+        <form class="formulario escondido" id="form-nova-senha" data-modo="nova-senha">
+          <p class="texto-suave">Escolhe a tua nova palavra-passe.</p>
+          <label class="campo">
+            <span>Nova palavra-passe</span>
+            <input type="password" name="senha" minlength="8" autocomplete="new-password" required />
+          </label>
+          <button type="submit" class="botao botao-principal">Guardar</button>
+        </form>
+
+        <p class="mensagem" id="mensagem" role="status"></p>
+      </div>
+    </main>
+  </body>
+</html>
